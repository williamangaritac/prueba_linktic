# ========================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ========================================
# 
# Copia este archivo a .env y configura tus valores
# cp .env.example .env

# ========================================
# GMAIL SMTP CONFIGURATION
# ========================================
# Para enviar notificaciones por email necesitas una contraseña de aplicación de Gmail
# 
# PASOS PARA OBTENER UNA CONTRASEÑA DE APLICACIÓN:
# 
# 1. Ve a tu cuenta de Google: https://myaccount.google.com/
# 2. Selecciona "Seguridad" en el menú lateral
# 3. Activa la "Verificación en 2 pasos" si no la tienes activada
# 4. Una vez activada, busca "Contraseñas de aplicaciones"
# 5. Selecciona "Correo" y "Otro (nombre personalizado)"
# 6. Escribe "Linktic E-Commerce" como nombre
# 7. Copia la contraseña de 16 caracteres que te genera
# 8. Pégala aquí abajo (sin espacios)

GMAIL_APP_PASSWORD=tu-contraseña-de-aplicacion-aqui

# Ejemplo (NO USAR ESTA):
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# IMPORTANTE: 
# - NO uses tu contraseña normal de Gmail
# - NO compartas este archivo .env en Git (ya está en .gitignore)
# - La contraseña debe ser de 16 caracteres sin espacios

