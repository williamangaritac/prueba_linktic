# ============================================
# LINKTIC STORE - Environment Variables
# ============================================
# Copiar este archivo como .env y configurar los valores
# cp .env.example .env

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=linktic_user
POSTGRES_PASSWORD=linktic_password_2024
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Databases
POSTGRES_DB_PRODUCTS=linktic_products
POSTGRES_DB_INVENTORY=linktic_inventory
POSTGRES_DB_NOTIFICATIONS=linktic_notifications

# ============================================
# MySQL Configuration
# ============================================
MYSQL_ROOT_PASSWORD=root_password_2024
MYSQL_USER=linktic_user
MYSQL_PASSWORD=linktic_password_2024
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=linktic_orders

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ZOOKEEPER_CONNECT=localhost:2181
KAFKA_TOPIC_ORDERS=order-events

# ============================================
# Eureka Server
# ============================================
EUREKA_SERVER_PORT=8761
EUREKA_SERVER_HOST=localhost

# ============================================
# API Gateway
# ============================================
API_GATEWAY_PORT=8080

# ============================================
# Microservices Ports
# ============================================
PRODUCTS_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
ORDERS_SERVICE_PORT=8083
NOTIFICATIONS_SERVICE_PORT=8084

# ============================================
# Email Configuration (Gmail)
# ============================================
# PASOS PARA OBTENER UNA CONTRASEÑA DE APLICACIÓN:
# 1. Ve a https://myaccount.google.com/
# 2. Seguridad > Verificación en 2 pasos (activar)
# 3. Contraseñas de aplicaciones > Correo > Otro
# 4. Nombre: "Linktic E-Commerce"
# 5. Copiar la contraseña de 16 caracteres

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password-aqui
MAIL_FROM=noreply@linktic.com

# ============================================
# Application Configuration
# ============================================
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO

# ============================================
# Frontend Configuration
# ============================================
ANGULAR_PORT=4200
API_BASE_URL=http://localhost:8080

