# ============================================
# VARIABLES DE ENTORNO PARA DESPLIEGUE EN AZURE
# ============================================
# Copiar este archivo a .env.azure y completar con tus valores reales

# ========================================
# SUPABASE - PRODUCTS DATABASE
# ========================================
# Formato: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# Ejemplo: postgresql://postgres:tu_password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
PRODUCTS_DB_URL=postgresql://postgres:[YOUR_PASSWORD]@[YOUR_PROJECT].supabase.co:5432/postgres
PRODUCTS_DB_USER=postgres
PRODUCTS_DB_PASSWORD=[YOUR_SUPABASE_PASSWORD]

# ========================================
# SUPABASE - INVENTORY DATABASE
# ========================================
INVENTORY_DB_URL=postgresql://postgres:[YOUR_PASSWORD]@[YOUR_PROJECT].supabase.co:5432/postgres
INVENTORY_DB_USER=postgres
INVENTORY_DB_PASSWORD=[YOUR_SUPABASE_PASSWORD]

# ========================================
# SUPABASE - NOTIFICATIONS DATABASE
# ========================================
NOTIFICATIONS_DB_URL=postgresql://postgres:[YOUR_PASSWORD]@[YOUR_PROJECT].supabase.co:5432/postgres
NOTIFICATIONS_DB_USER=postgres
NOTIFICATIONS_DB_PASSWORD=[YOUR_SUPABASE_PASSWORD]

# ========================================
# MYSQL (ORDERS SERVICE)
# ========================================
# Opción 1: MySQL en contenedor
MYSQL_ROOT_PASSWORD=linktic123_secure_prod
MYSQL_PASSWORD=linktic123_secure_prod

# Opción 2: Azure Database for MySQL (recomendado)
# ORDERS_DB_URL=jdbc:mysql://[YOUR_AZURE_MYSQL_SERVER].mysql.database.azure.com:3306/linktic_orders?useSSL=true
# ORDERS_DB_USER=linktic@[YOUR_AZURE_MYSQL_SERVER]
# ORDERS_DB_PASSWORD=[YOUR_MYSQL_PASSWORD]

# ========================================
# GMAIL SMTP (Para notificaciones)
# ========================================
MAIL_USERNAME=linktic515@gmail.com
MAIL_PASSWORD=[YOUR_GMAIL_APP_PASSWORD]

# ========================================
# AZURE CONFIGURATION (Opcional)
# ========================================
AZURE_SUBSCRIPTION_ID=[YOUR_SUBSCRIPTION_ID]
AZURE_RESOURCE_GROUP=rg-linktic-ecommerce
AZURE_LOCATION=eastus
AZURE_CONTAINER_REGISTRY=[YOUR_ACR_NAME].azurecr.io

# ========================================
# FRONTEND CONFIGURATION
# ========================================
# URL del API Gateway una vez desplegado en Azure
API_GATEWAY_URL=https://[YOUR_AZURE_APP].azurewebsites.net

# ========================================
# KAFKA/EVENT HUBS (Opcional - para notificaciones avanzadas)
# ========================================
# Si decides usar Azure Event Hubs en lugar de Kafka
# SPRING_KAFKA_BOOTSTRAP_SERVERS=[YOUR_NAMESPACE].servicebus.windows.net:9093
# SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=PLAIN
# SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SASL_SSL
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=...
